# --- ОБЯЗАТЕЛЬНО ---
BOT_TOKEN=            # токен из @BotFather
GROQ_API_KEY=         # ключ с console.groq.com (бесплатный тариф)

# --- РЕКОМЕНДУЕТСЯ ---
YANDEX_WEATHER_KEY=   # Яндекс Погода: Яндекс Облако -> Weather API (бесплатный тест)

# --- ОПЦИОНАЛЬНО ---
SUB_CHANNEL=          # @username канала или -100123... (включает обязательную подписку)
SUB_CHANNEL_URL=      # ссылка на канал, если он приватный
PEXELS_API_KEY=       # фото-референсы стилей (pexels.com/api, бесплатно)
FALLBACK_OPEN_METEO=0 # 1 = аварийный запас Open-Meteo, если русские источники упали
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
